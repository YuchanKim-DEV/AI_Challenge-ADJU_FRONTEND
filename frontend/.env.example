# 프론트가 호출할 API 베이스.
# 기본값은 vite dev 프록시(/api → FastAPI 18000)를 사용하도록 상대경로 /api.
VITE_API_BASE=/api

# vite.config.ts 프록시가 바라볼 실제 FastAPI 주소.
# - SSH 포워딩 사용 시(권장):
#     ssh -i <was2.pem> -p 30022 -L 18000:localhost:18000 ubuntu@180.210.78.147
#   → VITE_API_TARGET=http://localhost:18000
# - 18000 포트가 외부 개방됐다면:
#     VITE_API_TARGET=http://180.210.78.147:18000
VITE_API_TARGET=http://localhost:18000
